{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Template settings",
  "type": "object",
  "properties": {
    "rotation": {
      "type": "integer",
      "description": "Rotate pasted artwork by this many degrees"
    },
    "bleedPaths": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Additional bleed path names to use"
    },
    "bleedMode": {
      "type": "string",
      "enum": ["auto", "manual"],
      "description": "How bleed targets are selected"
    },
    "mirror": {
      "type": "boolean",
      "description": "Mirror artwork horizontally before placement"
    },
    "artworkScale": {
      "type": "number",
      "minimum": 0,
      "description": "Scale factor applied to artwork (1 = 100%)"
    },
    "alignment": {
      "type": "string",
      "enum": [
        "top-left",
        "top-center",
        "top-right",
        "center-left",
        "center",
        "center-right",
        "bottom-left",
        "bottom-center",
        "bottom-right"
      ],
      "description": "Anchor point for placing artwork"
    }
  },
  "additionalProperties": false,
  "BleedFailSafeSettings": {
    "title": "Bleed fail-safe settings",
    "type": "object",
    "properties": {
      "defaultRotation": {
        "type": "number",
        "description": "Fallback rotation when no template-specific value is set"
      },
      "rotation": {
        "type": "number",
        "description": "Legacy fallback rotation value"
      },
      "templates": {
        "type": "object",
        "description": "Per-template fail-safe overrides keyed by template code",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "number",
              "description": "Legacy rotation-only entry"
            },
            {
              "type": "object",
              "properties": {
                "templateCode": {
                  "type": "string",
                  "description": "Template code this entry applies to"
                },
                "dieName": {
                  "type": "string",
                  "description": "Descriptive die name for this template"
                },
                "rotation": {
                  "type": "number",
                  "description": "Rotation to apply when recreating bleed"
                }
              },
              "required": ["rotation", "dieName"],
              "additionalProperties": true
            }
          ]
        }
      }
    },
    "required": ["templates"],
    "additionalProperties": true
  }
}
